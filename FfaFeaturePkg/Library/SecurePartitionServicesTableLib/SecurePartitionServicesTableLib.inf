[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = SecurePartitionServicesTableLib
  FILE_GUID                      = 5118C38F-D97D-4FF8-8B44-971273B07342
  MODULE_TYPE                    = MM_CORE_STANDALONE
  VERSION_STRING                 = 1.0
  PI_SPECIFICATION_VERSION       = 0x00010032
  LIBRARY_CLASS                  = SecurePartitionServicesTableLib|MM_CORE_STANDALONE

#
#  VALID_ARCHITECTURES           = AARCH64
#

[Sources]
  SecurePartitionServicesTableLib.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  FfaFeaturePkg/FfaFeaturePkg.dec

#
# Standalone MM Core requires position-independent code for self-relocation.
# Apply PIE only to ELF toolchains because PE/COFF targets do not support it.
#
[BuildOptions]
  GCC:*_GCC_ARM_CC_FLAGS = -fpie
  GCC:*_GCC_AARCH64_CC_FLAGS = -fpie
  CLANGDWARF:*_CLANGDWARF_ARM_CC_FLAGS = -fpie
  CLANGDWARF:*_CLANGDWARF_AARCH64_CC_FLAGS = -fpie
